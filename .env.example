# ==============================================================================
# FB Multi-Hub v2.0 - Configuration Template (.env.example)
# Sao chép tệp này thành .env và điền các giá trị phù hợp với hệ thống của bạn.
# ==============================================================================

# Cổng khởi chạy máy chủ Express (Mặc định: 3000)
PORT=3000

# Mã bảo mật Verify Token dùng cho Meta Webhook Callback Verification
VERIFY_TOKEN=fb_tool_verify_secret_2026

# Múi giờ vận hành chuẩn cho ca trực & báo thức (Mặc định: Asia/Ho_Chi_Minh - GMT+7)
OPERATIONAL_TIMEZONE=Asia/Ho_Chi_Minh

# ==============================================================================
# CẤU HÌNH ỨNG DỤNG META DEVELOPER (Tùy chọn - có thể nhập trực tiếp trên giao diện)
# ==============================================================================
# Lấy từ Meta Developer Dashboard > App Settings > Basic
META_APP_ID=
META_APP_SECRET=

# ==============================================================================
# CẤU HÌNH THÔNG BÁO BÁO ĐỘNG KHẨN CẤP TOÀN CỤC (Tùy chọn)
# ==============================================================================
# Kênh cảnh báo Discord Webhook
GLOBAL_DISCORD_WEBHOOK_URL=

# Kênh cảnh báo Telegram Bot
GLOBAL_TELEGRAM_BOT_TOKEN=
GLOBAL_TELEGRAM_CHAT_ID=

# Báo thức di động miễn phí qua ứng dụng ntfy (iOS / Android)
# Tải app ntfy trên điện thoại, đăng ký theo dõi topic này để nhận chuông báo
NTFY_TOPIC=fb_multi_hub_alarm_2026

# Cuộc gọi khẩn cấp viễn thông trực tiếp vào SIM di động qua Twilio VoIP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
